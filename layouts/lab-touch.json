{
  "id": "lab-touch",
  "title": "AP3X LAB",
  "stage": {
    "width": 800,
    "height": 480,
    "fontSize": 18
  },
  "refreshSeconds": 15,
  "regionColumns": "minmax(0, 1fr)",
  "navigation": "pages",
  "chrome": "compact",
  "homeAfterSeconds": 120,
  "regions": [
    {
      "id": "home",
      "title": "HOME",
      "columns": "minmax(0, 1fr)",
      "rows": "minmax(0, 1fr)",
      "panels": [
        {
          "id": "home",
          "module": "lab-home",
          "title": "AP3X LAB",
          "settings": {
            "place": "LAB",
            "pages": {
              "printers": "printers",
              "nodes": "network",
              "network": "network"
            }
          }
        }
      ]
    },
    {
      "id": "printers",
      "title": "PRINTERS",
      "columns": "minmax(0, 1fr)",
      "rows": "minmax(0, 1fr)",
      "panels": [
        {
          "id": "printers",
          "module": "lab-printers",
          "title": "LAB PRINTERS"
        }
      ]
    },
    {
      "id": "cameras",
      "title": "CAMERAS",
      "columns": "repeat(2, minmax(0, 1fr))",
      "rows": "repeat(2, minmax(0, 1fr))",
      "panels": [
        {
          "id": "cam-x1c",
          "module": "camera",
          "title": "X1C",
          "settings": {
            "label": "X1C",
            "url": "/go2rtc/api/frame.jpeg?src=lab_x1c",
            "streamUrl": "/go2rtc/stream.html?src=lab_x1c&mode=mse",
            "refreshSeconds": 3,
            "liveMinutes": 10
          }
        },
        {
          "id": "cam-h2c",
          "module": "camera",
          "title": "H2C",
          "settings": {
            "label": "H2C",
            "url": "/go2rtc/api/frame.jpeg?src=lab_h2c",
            "streamUrl": "/go2rtc/stream.html?src=lab_h2c&mode=mse",
            "refreshSeconds": 3,
            "liveMinutes": 10
          }
        },
        {
          "id": "cam-p2s",
          "module": "camera",
          "title": "P2S",
          "settings": {
            "label": "P2S",
            "url": "/go2rtc/api/frame.jpeg?src=lab_p2s",
            "streamUrl": "/go2rtc/stream.html?src=lab_p2s&mode=mse",
            "refreshSeconds": 3,
            "liveMinutes": 10
          }
        },
        {
          "id": "cam-r1",
          "module": "camera",
          "title": "R1 LASER",
          "settings": {
            "label": "R1 LASER",
            "url": "/go2rtc/api/frame.jpeg?src=lab_r1",
            "streamUrl": "/go2rtc/stream.html?src=lab_r1&mode=mse",
            "refreshSeconds": 3,
            "liveMinutes": 10
          }
        }
      ]
    },
    {
      "id": "climate",
      "title": "CLIMATE",
      "columns": "minmax(0, 1.15fr) minmax(0, 1fr)",
      "rows": "minmax(0, 1fr)",
      "panels": [
        {
          "id": "weather",
          "module": "weather",
          "title": "OUTSIDE"
        },
        {
          "id": "climate",
          "module": "lab-climate",
          "title": "LAB CLIMATE"
        }
      ]
    },
    {
      "id": "network",
      "title": "NETWORK",
      "columns": "minmax(0, 1.25fr) minmax(0, 1fr)",
      "rows": "minmax(0, 1fr) minmax(0, 1fr)",
      "panels": [
        {
          "id": "net",
          "module": "net-io",
          "title": "NETWORK I/O",
          "row": "1 / 3"
        },
        {
          "id": "labpi1",
          "module": "lab-node",
          "title": "LABPI1"
        },
        {
          "id": "nodes",
          "module": "node-status",
          "title": "MACHINES"
        }
      ]
    }
  ]
}
